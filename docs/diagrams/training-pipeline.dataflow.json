  "cards": [
    {
      "dot": "orange",
      "title": "Bottleneck first",
      "items": [
        "JPEG decoding capped at 1,550 img/s, half of what the GPU consumes",
        "A one-time uint8 cache moved the limit back to the GPU"
      ]
    },
    {
      "dot": "emerald",
      "title": "Throughput",
      "items": [
        "AMP alone gave 1.56x over FP32",
        "Adding channels_last reached 1.89x (1,627 to 3,068 img/s)"
      ]
    },
    {
      "dot": "rose",
      "title": "INT8 PTQ (fbgemm, batch 1)",
      "items": [
        "4x smaller and 2.2x faster on one CPU thread",
        "Test accuracy unchanged, so QAT had nothing to recover"
      ]
    }
  ]
